#include "socfpga_cyclone5.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>

/ {
	model = "Terasic DE10-nano";
	compatible = "terasic,de10-nano", "altr,socfpga-cyclone5", "altr,socfpga";

	chosen {
		bootargs = "earlyprintk";
		stdout-path = "serial0:115200n8";
	};

	memory {
		name = "memory";
		device_type = "memory";
		reg = <0x0 0x40000000>; /* 1GB */
	};

	aliases {
		ethernet0 = &gmac1;
	};

	regulator_3_3v: 3-3-v-regulator {
		compatible = "regulator-fixed";
		regulator-name = "3.3V";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
	};

	leds {
		compatible = "gpio-leds";
		hps0 {
			label = "hps_led0";
			gpios = <&portb 24 0>;
			linux,default-trigger = "mmc0";
		};
	};

/*
	ltcmode {
		compatible = "gpio-leds";
		ltcsw {
			label = "ltc_sw";
			gpios = <&portb 11 0>;
			default-state = "off";
		};
	};
*/

	i2c_gpio {
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "i2c-gpio";
		gpios = <&portb 22 (GPIO_ACTIVE_HIGH|GPIO_OPEN_DRAIN)
                         &portb 23 (GPIO_ACTIVE_HIGH|GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <2>;

		rtc_at_51 {
			compatible = "pcf8563";
			reg = <0x51>;
		};
		rtc_at_68 {
		        compatible = "m41t81";
		        reg = <0x68>;
		};
		rtc_at_6F {
		        compatible = "mcp7941x";
		        reg = <0x6F>;
		};
	};

	MiSTer_fb {
		compatible = "MiSTer_fb";
		reg = <0x22000000 0x800000>;
		interrupt-parent = <&intc>;
		interrupts = < 0 40 1 >;
	};
};

&gmac1 {
	status = "okay";
	phy-mode = "rgmii";

	txd0-skew-ps = <0>; /* -420ps */
	txd1-skew-ps = <0>; /* -420ps */
	txd2-skew-ps = <0>; /* -420ps */
	txd3-skew-ps = <0>; /* -420ps */
	rxd0-skew-ps = <420>; /* 0ps */
	rxd1-skew-ps = <420>; /* 0ps */
	rxd2-skew-ps = <420>; /* 0ps */
	rxd3-skew-ps = <420>; /* 0ps */
	txen-skew-ps = <0>; /* -420ps */
	txc-skew-ps = <1860>; /* 960ps */
	rxdv-skew-ps = <420>; /* 0ps */
	rxc-skew-ps = <1680>; /* 780ps */

	max-frame-size = <3800>;
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&gpio2 {
	status = "okay";
};

&i2c0 {
	status = "okay";
	speed-mode = <0>;

	adxl345: adxl345@53 {
		compatible = "adi,adxl345";
		reg = <0x53>;

		interrupt-parent = <&portc>;
		interrupts = <3 2>;
	};
};

&i2c2 {
	status = "okay";
	clock-frequency = <100000>;
	speed-mode = <0>;
};

&spi0 {
	status = "okay";
	timeouts = <3>;
	spiusb@0 {
		compatible = "MiSTer,spi-audio";
		reg = <0>;
		spi-max-frequency = <10000000>;
		spi-cpha;
		spi-cpol;
		status = "okay";
	};
};

&spi1 {
	status = "okay";
	timeouts = <3>;
	spibri@0 {
		status = "okay";
		compatible = "altspi";
		spi-max-frequency = <25000000>;
		reg = <0>;
	};
};

&mmc0 {
	vmmc-supply = <&regulator_3_3v>;
	vqmmc-supply = <&regulator_3_3v>;
	status = "okay";
};

&uart0 {
	/delete-property/dmas;
	/delete-property/dma-names;
	status = "okay";
};

&uart1 {
	/delete-property/dmas;
	/delete-property/dma-names;
	status = "okay";
};

&usb1 {
	disable-over-current;
	dr_mode = "host";
	status = "okay";
};

&fpga_bridge0 {
	status = "okay";
};

&fpga_bridge1 {
	status = "okay";
};

&fpga_bridge2 {
	status = "okay";
};

&ocram {
	#address-cells = <1>;
	#size-cells = <1>;
	ranges = <0 0xffff0000 0x10000>;

	flags-sram@f000 {
		reg = <0xf000 0x1000>;
	};
};

/* MiSTer HPS<->FPGA interface */
/ {
	/* FPGA-shared DDR, kept from the kernel by the DTB, not only mem=511M. */
	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		mister_ddr_low: mister-ddr-low@1ff00000 {
			reg = <0x1ff00000 0x000ff000>;
			no-map;
		};

		mister_handoff: mister-handoff@1ffff000 {
			reg = <0x1ffff000 0x00001000>;
			no-map;
		};

		mister_scaler: mister-scaler@20000000 {
			reg = <0x20000000 0x01800000>;
			no-map;
		};

		mister_core_lo: mister-core@21800000 {
			reg = <0x21800000 0x00800000>;
			no-map;
		};

		/* Upper 16 MiB shared: SS20 PROM/RAM; stock SNES/SGB MSU, menu bg. */
		mister_fb_mem: mister-fb@22000000 {
			reg = <0x22000000 0x01800000>;
			no-map;
		};

		mister_core_hi: mister-core@23800000 {
			reg = <0x23800000 0x1c800000>;
			no-map;
		};
	};

	MiSTer_fb {
		memory-region = <&mister_fb_mem>;
	};

	/* Map-only UIO nodes, uio name mister_<name>; MAP_SHARED only. */
	mister {
		compatible = "simple-mfd";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/* H-1: an undecoded offset hangs the SoC; touch only declared offsets. */
		lw-bridge@ff200000 {
			compatible = "generic-uio";
			linux,uio-name = "mister_lw_bridge";
			reg = <0xff200000 0x00200000>;
		};

		/* H-1: no published core decodes any offset of this window. */
		h2f-bridge@c0000000 {
			compatible = "generic-uio";
			linux,uio-name = "mister_h2f_bridge";
			reg = <0xc0000000 0x3c000000>;
		};

		/* Shared with fpgamgr0; GPO +0x10, GPI +0x14. */
		fpga-mgr@ff706000 {
			compatible = "generic-uio";
			linux,uio-name = "mister_fpga_mgr";
			reg = <0xff706000 0x00001000>;
		};

		ddr-aperture@20000000 {
			compatible = "generic-uio";
			linux,uio-name = "mister_ddr_aperture";
			reg = <0x20000000 0x20000000>;
			mister,map-writecombine;
		};

		ddr-low@1ff00000 {
			compatible = "generic-uio";
			linux,uio-name = "mister_ddr_low";
			reg = <0x1ff00000 0x000ff000>,
			      <0x1ffff000 0x00001000>;
		};

		/* Warm boot runs the SPL image at +0: clear warmramgrp.enable before a store. */
		ocram@ffff0000 {
			compatible = "generic-uio";
			linux,uio-name = "mister_ocram";
			reg = <0xffff0000 0x0000f000>;
		};

		/* f2h_irq[N] = GIC SPI 40+N; N=0 is MiSTer_fb's vsync. */
		fabric-irqs {
			compatible = "simple-mfd";
			interrupt-parent = <&intc>;

			f2h-irq1 {
				compatible = "generic-uio";
				linux,uio-name = "mister_f2h_irq1";
				interrupts = <0 41 IRQ_TYPE_EDGE_RISING>;	/* video_sync, a pulse */
			};

			f2h-irq2 {
				compatible = "generic-uio";
				linux,uio-name = "mister_f2h_irq2";
				interrupts = <0 42 IRQ_TYPE_LEVEL_HIGH>;
			};

			f2h-irq3 {
				compatible = "generic-uio";
				linux,uio-name = "mister_f2h_irq3";
				interrupts = <0 43 IRQ_TYPE_LEVEL_HIGH>;
			};

			f2h-irq4 {
				compatible = "generic-uio";
				linux,uio-name = "mister_f2h_irq4";
				interrupts = <0 44 IRQ_TYPE_LEVEL_HIGH>;
			};

			f2h-irq5 {
				compatible = "generic-uio";
				linux,uio-name = "mister_f2h_irq5";
				interrupts = <0 45 IRQ_TYPE_LEVEL_HIGH>;
			};

			f2h-irq6 {
				compatible = "generic-uio";
				linux,uio-name = "mister_f2h_irq6";
				interrupts = <0 46 IRQ_TYPE_LEVEL_HIGH>;
			};

			f2h-irq7 {
				compatible = "generic-uio";
				linux,uio-name = "mister_f2h_irq7";
				interrupts = <0 47 IRQ_TYPE_LEVEL_HIGH>;
			};

			f2h-irq8 {
				compatible = "generic-uio";
				linux,uio-name = "mister_f2h_irq8";
				interrupts = <0 48 IRQ_TYPE_LEVEL_HIGH>;
			};

			f2h-irq9 {
				compatible = "generic-uio";
				linux,uio-name = "mister_f2h_irq9";
				interrupts = <0 49 IRQ_TYPE_LEVEL_HIGH>;
			};

			f2h-irq10 {
				compatible = "generic-uio";
				linux,uio-name = "mister_f2h_irq10";
				interrupts = <0 50 IRQ_TYPE_LEVEL_HIGH>;
			};

			f2h-irq11 {
				compatible = "generic-uio";
				linux,uio-name = "mister_f2h_irq11";
				interrupts = <0 51 IRQ_TYPE_LEVEL_HIGH>;
			};

			f2h-irq12 {
				compatible = "generic-uio";
				linux,uio-name = "mister_f2h_irq12";
				interrupts = <0 52 IRQ_TYPE_LEVEL_HIGH>;
			};

			f2h-irq13 {
				compatible = "generic-uio";
				linux,uio-name = "mister_f2h_irq13";
